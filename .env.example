# Skopiuj ten plik do .env.local i uzupełnij wartościami z panelu Supabase
# (Project Settings -> API Keys). Pliku .env.local nigdy nie commituj (jest w .gitignore).

# Adres URL projektu Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (dawniej "anon public") — bezpieczny w przeglądarce, dostęp ograniczają reguły RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "Secret key" (dawniej "service_role") — WYŁĄCZNIE po stronie serwera, używany do
# zakładania kont pracownikom. Nigdy nie dodawaj mu prefiksu NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
